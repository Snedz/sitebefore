---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import { scope, displayPrice } from '../lib/offer.mjs';
const steps = [
  [
    '01',
    'See your preview',
    'Open the private link we sent. Explore a site built around your business and the things that make it yours.',
  ],
  [
    '02',
    'Keep what you like',
    'Review the scope and price on your preview. If the site feels right, check out online.',
  ],
  [
    '03',
    'Make it yours',
    'Share your edits in writing. We’ll make the agreed changes and help connect the site to your domain.',
  ],
];
---

<Base
  title="SiteBefore — A website you can see before you buy"
  description="See a website built for your local business before you buy it. One fixed price, online checkout and a launch handoff."
  canonical="https://www.sitebefore.com/"
  image="https://www.sitebefore.com/images/juniper-hero.webp"
>
  <a class="skip button" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap top-inner">
      <Brand />
      <nav aria-label="Main navigation"><a href="#how">How it works</a><a href="#pricing">Pricing</a></nav>
      <a class="button outline nav-button" href="/sample/">View sample <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main">
    <section class="hero wrap">
      <div class="intro">
        <p class="eyebrow hero-label"><span></span> Websites for local businesses</p>
        <h1>Your next website.<br /><em>Already built.</em></h1>
        <p class="lede">
          See what a new website could look like for your business before you buy it. Like what you see? Make
          it yours online, without a call.
        </p>
        <div class="actions">
          <a class="button" href="/sample/">Explore a sample <span aria-hidden="true">↗</span></a><a
            class="text-link"
            href="#how">How it works <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="example">
        <a class="browser" href="/sample/" aria-label="View the Juniper Motor Works sample">
          <div class="browser-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span>JUNIPER MOTOR WORKS</span
            ><span aria-hidden="true">↗</span>
          </div>
          <div class="browser-cover">
            <img src="/images/juniper-hero.webp" alt="" width="1280" height="853" fetchpriority="high" /><div
              class="cover-text"
            >
              <span>JUNIPER MOTOR WORKS</span><strong>Good work.<br />Good miles.</strong><small
                >EXPLORE THE SHOP &nbsp; ↗</small>
            </div>
          </div>
          <div class="browser-footer"><span>01 / THE WORKSHOP</span><span>INDEPENDENT AUTO CARE</span></div>
        </a>
        <figcaption>
          <span class="stamp-dot"></span> Sample site <span class="caption-divider"></span> Auto repair
        </figcaption>
      </figure>
    </section>
    <section class="process" id="how">
      <div class="wrap">
        <div class="section-header">
          <div><p class="eyebrow">How it works</p><h2>From preview to <em>published.</em></h2></div><p>
            Already have a preview link? Open it to review your site and see your offer.
          </p>
        </div>
        <div class="steps">
          {
            steps.map(([number, heading, copy]) => (
              <article>
                <>
                  <span>{number}</span>
                  <h3>{heading}</h3>
                  <p>{copy}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="pricing wrap" id="pricing">
      <div>
        <p class="eyebrow">The launch package</p><h2>One site.<br /><em>One fixed price.</em></h2><p
          class="muted"
        >
          Checkout is available through an approved preview link.
        </p>
      </div>
      <div class="price-card">
        <p class="price">{displayPrice()}</p><p class="muted">
          {displayPrice('CAD')} for Canadian businesses. One-time payment.
        </p>
        <ul>
          {
            scope.map((item) => (
              <li>
                <span aria-hidden="true">✓</span>
                {item}
              </li>
            ))
          }
        </ul><a class="button" href="/sample/">View the sample <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <footer class="footer">
    <div class="wrap">
      <Brand inverse /><a href="/sample/">Sample site</a><a href="/agency/">Operator sign-in</a>
    </div>
  </footer>
</Base>
<style>
  .top {
    border-bottom: 1px solid #dedacf;
  }
  .top-inner {
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .top nav {
    display: flex;
    gap: 34px;
  }
  .top nav a,
  .text-link,
  .footer a {
    font-size: 0.89rem;
    font-weight: 720;
    text-decoration: none;
  }
  .top nav a:hover,
  .text-link:hover,
  .footer a:hover {
    text-decoration: underline;
  }
  .nav-button {
    min-height: 39px;
    font-size: 0.85rem;
  }
  .hero {
    display: grid;
    grid-template-columns: 0.96fr 1fr;
    gap: clamp(25px, 5vw, 75px);
    align-items: center;
    padding-block: 87px 100px;
  }
  .hero-label {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    margin-bottom: 25px;
  }
  .hero-label span,
  .stamp-dot {
    width: 8px;
    height: 8px;
    background: #cf694e;
    border-radius: 50%;
    display: inline-block;
  }
  .intro h1 {
    font-size: clamp(3.25rem, 6.05vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.075em;
  }
  .intro h1 em,
  .section-header h2 em,
  .pricing h2 em {
    font-family: var(--serif);
    letter-spacing: -0.03em;
    font-weight: 400;
  }
  .intro h1 em {
    font-size: 1.12em;
    color: #42604d;
  }
  .lede {
    font-size: 1.07rem;
    max-width: 390px;
    margin-top: 24px;
    color: #3d4e45;
    line-height: 1.65;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .text-link {
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }
  .example {
    position: relative;
    margin: 0;
  }
  .browser {
    display: block;
    overflow: hidden;
    border-radius: 11px;
    border: 1px solid #d1d0bb;
    text-decoration: none;
    background: #e8e4d6;
    box-shadow: 0 20px 45px #26372b21;
  }
  .browser:hover {
    box-shadow: 0 23px 48px #26372b37;
  }
  .browser-bar,
  .browser-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 15px;
    font-size: 0.59rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #475348;
  }
  .dots {
    display: flex;
    gap: 4px;
  }
  .dots i {
    width: 5px;
    height: 5px;
    background: #9ca494;
    border-radius: 50%;
  }
  .browser-cover {
    position: relative;
    aspect-ratio: 1.58;
    overflow: hidden;
    background: #29372b;
    color: #fff6df;
  }
  .browser-cover img {
    height: 100%;
    object-fit: cover;
    object-position: center 51%;
  }
  .browser-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #14231ad9, #14231a0a 86%);
  }
  .cover-text {
    position: absolute;
    z-index: 1;
    left: 6%;
    top: 12%;
    bottom: 11%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
  }
  .cover-text span,
  .cover-text small {
    font-size: clamp(0.45rem, 1vw, 0.65rem);
    letter-spacing: 0.14em;
    font-weight: 800;
  }
  .cover-text strong {
    font-family: var(--serif);
    font-size: clamp(2rem, 4.9vw, 4.8rem);
    font-weight: 400;
    line-height: 0.84;
  }
  .cover-text small {
    border: 1px solid #f6e9ccaa;
    padding: 6px 9px;
  }
  .browser-footer {
    background: #f5f0e5;
  }
  figcaption {
    position: absolute;
    right: 13px;
    bottom: -14px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 0.71rem;
    font-weight: 750;
    box-shadow: 0 4px 9px #23332b15;
  }
  .caption-divider {
    width: 1px;
    height: 11px;
    background: #c4cabc;
  }
  .process {
    background: var(--green);
    color: var(--cream);
    padding-block: 59px 70px;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 31px;
  }
  .section-header .eyebrow {
    color: #f4b29d;
  }
  .section-header h2,
  .pricing h2 {
    font-size: clamp(2.6rem, 5vw, 4.25rem);
    margin-top: 11px;
  }
  .section-header > p {
    max-width: 265px;
    color: #d3dcd0;
    font-size: 0.9rem;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 13px;
  }
  .steps article {
    border: 1px solid #53695a;
    border-radius: 8px;
    padding: 22px;
  }
  .steps article > span {
    display: inline-grid;
    place-items: center;
    border: 1px solid #849688;
    border-radius: 50%;
    width: 34px;
    height: 34px;
    font-size: 0.7rem;
    color: #f5b6a3;
    font-weight: 800;
  }
  .steps h3 {
    font-size: 1.4rem;
    margin-block: 15px 8px;
  }
  .steps p {
    color: #d4ded1;
    font-size: 0.89rem;
  }
  .pricing {
    padding-block: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
  }
  .pricing h2 {
    margin-bottom: 15px;
  }
  .pricing h2 em {
    color: #42604d;
  }
  .price-card {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 25px;
    background: var(--paper);
  }
  .price {
    font-family: var(--display);
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.1;
  }
  .price-card ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 9px;
    margin: 18px 0;
  }
  .price-card li {
    display: flex;
    gap: 8px;
  }
  .price-card li span {
    color: #396047;
    font-weight: 800;
  }
  .footer {
    background: #172a22;
    color: var(--cream);
    padding-block: 28px;
  }
  .footer > .wrap {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer .brand {
    margin-right: auto;
  }
  @media (max-width: 900px) {
    .hero {
      gap: 24px;
      padding-block: 65px 85px;
    }
    .intro h1 {
      font-size: clamp(2.9rem, 6.6vw, 4.8rem);
    }
  }
  @media (max-width: 700px) {
    .hero,
    .pricing {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .hero {
      padding-block: 47px 63px;
    }
    .intro h1 {
      font-size: clamp(3rem, 10.3vw, 5rem);
    }
    .cover-text strong {
      font-size: clamp(2.5rem, 9vw, 4.5rem);
    }
    .top nav {
      display: none;
    }
    .top-inner {
      min-height: 62px;
    }
    .section-header {
      align-items: start;
      flex-direction: column;
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .pricing,
    .process {
      padding-block: 48px;
    }
  }
</style>
