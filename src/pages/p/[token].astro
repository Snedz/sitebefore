---
import Base from '../../layouts/Base.astro';
import OrderReceipt from '../../components/OrderReceipt.astro';
import StoryPreview from '../../components/StoryPreview.astro';
import PricePanel from '../../components/PricePanel.astro';
import { demoBusinessUrl } from '../../data/demo-prospect.mjs';
import { checkoutMode, checkoutOrigin } from '../../lib/checkout.mjs';
import { privateHeaders } from '../../lib/http.mjs';
import { getStore, prospectSummary } from '../../lib/store.mjs';
export const prerender = false;

for (const [key, value] of Object.entries(privateHeaders)) Astro.response.headers.set(key, value);
const token = Astro.params.token ?? '';
const receiptOnly = Astro.url.searchParams.get('receipt') === '1';
const receiptPath = '/p/' + token + '/?receipt=1';
let lead;
let receipt;
if (/^[A-Za-z0-9_-]{32}$/.test(token)) {
  try {
    const store = await getStore();
    if (!receiptOnly) lead = await store.publicLead(token);
    if (receiptOnly || !lead) receipt = await store.publicReceipt(token);
  } catch (err) {
    Astro.response.status = err.status === 503 ? 503 : 500;
  }
}
if (!lead && !(receiptOnly && receipt) && Astro.response.status === 200) {
  Astro.response.status = receipt ? 410 : 404;
}
let mode = checkoutMode();
if (mode === 'stripe-test') {
  const origin = checkoutOrigin();
  if (lead && origin && origin !== Astro.url.origin) {
    const location = new URL('/p/' + token + '/' + Astro.url.search, origin).href;
    return new Response(null, { status: 307, headers: {...privateHeaders, location} });
  }
  if (!origin) mode = null;
}
const status = Astro.url.searchParams.get('checkout');
---

{
  receiptOnly && receipt ? (
    <Base title="Order receipt · SiteBefore" privatePage>
      <main class="wrap missing stack">
        <h1>Order receipt</h1>
        <OrderReceipt lead={receipt} />
      </main>
    </Base>
  ) : lead ? (
    <StoryPreview profile={prospectSummary(lead)} contactUrl={lead.data.businessUrl === demoBusinessUrl ? undefined : lead.data.businessUrl}>
      <PricePanel currency={lead.data.currency} offer={lead.offer}>
        {lead.paid_at ? (
          <OrderReceipt lead={lead} />
        ) : (
          <div class="stack">
            {status === 'returned' &&
              (lead.checkout_id ? (
                <p class="notice" role="status">
                  Waiting for payment confirmation.{' '}
                  <a href={`/p/${token}/?checkout=returned#offer`}>Refresh order status</a>.
                </p>
              ) : (
                <p class="notice" role="status">
                  No payment is confirmed. You can try checkout again below.
                </p>
              ))}
            {status === 'cancelled' && (
              <p class="notice" role="status">
                You returned from checkout. You can resume whenever you’re ready.
              </p>
            )}
            {mode ? (
              <form class="stack" method="post" action="/api/checkout">
                <input type="hidden" name="token" value={token} />
                {mode === 'demo' && status === 'demo' ? (
                  <div class="stack">
                    <p class="notice">Local checkout simulation. No money will move.</p>
                    <div class="actions">
                      <button class="button" type="submit" name="action" value="simulate">
                        Simulate test payment
                      </button>
                      <a href={`/p/${token}/?checkout=cancelled#offer`}>Cancel checkout</a>
                    </div>
                  </div>
                ) : (
                  <div class="stack">
                    <button class="button" type="submit">
                      {lead.attempt ? 'Resume test checkout' : 'Start test checkout'}
                    </button>
                    <small>Test checkout only. You won’t be charged.</small>
                  </div>
                )}
              </form>
            ) : (
              <p class="notice">Checkout is unavailable for this review.</p>
            )}
          </div>
        )}
      </PricePanel>
    </StoryPreview>
  ) : (
    <Base title="Preview unavailable · SiteBefore" privatePage>
      <main class="wrap missing stack">
        <h1>Preview unavailable</h1>
        <>
          <p>
            {receipt ? 'This preview is no longer available. Your order is unchanged.' : Astro.response.status >= 500
              ? 'Try again in a moment.'
              : 'Check the full link that came with your invitation.'}
          </p>
          {receipt && <p><a href={receiptPath}>View your order receipt</a></p>}
          <p>
            <a href="/">Return to SiteBefore</a>
          </p>
        </>
      </main>
    </Base>
  )
}
<style>
  .notice {
    padding: 12px;
    border-radius: 6px;
    background: #edf2e9;
    color: var(--ink);
  }
  .notice code {
    overflow-wrap: anywhere;
  }
  .missing {
    padding-block: 75px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  form button {
    justify-self: start;
  }
</style>
