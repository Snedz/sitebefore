---
import '@fontsource/barlow-condensed/latin-700.css';
import Base from '../layouts/Base.astro';
import Brand from './Brand.astro';
import { businessPhoneLink } from '../lib/prospect.mjs';
const { profile, sample = false, contactUrl } = Astro.props;
const concerns = sample ? profile.concerns : null;
const hero = sample ? profile.hero : null;
const craft = sample ? profile.craft : null;
const shopName = sample ? 'Juniper' : profile.name;
const phoneLink = businessPhoneLink(profile.phone);
const contactHref = phoneLink ?? contactUrl;
const contactLabel = phoneLink ? 'Call the business' : 'Contact the business';
---

<Base title={`${profile.name} · SiteBefore Preview`} privatePage>
  <a class="skip button" href="#main">Skip to content</a>
  <aside class="preview-bar" aria-label="SiteBefore preview">
    <div class="wrap bar-wrap">
      <Brand /><span>{sample ? 'Fictional sample' : 'Private preview · Unaffiliated'}</span>
      <a href="#offer">{sample ? 'Launch package' : 'Review your offer'} <span aria-hidden="true">↓</span></a>
    </div>
  </aside>
  <main id="main">
    <div class:list={['shop', { dossier: !sample }]}>
      <header class="shop-header" id="shop">
        <div class="shop-wrap shop-nav">
          <a class="wordmark" href="#shop" aria-label={profile.name}>
            {shopName}{sample && <small>Motor Works</small>}
          </a>
          <nav aria-label="Shop navigation">
            <a href="#services">Services</a>
            {profile.story && <a href="#workshop">About</a>}
            {contactHref && <a href={contactHref}>{phoneLink ? 'Call' : 'Contact'}</a>}
          </nav>
        </div>
      </header>
      <section class:list={['work-hero', { illustrated: hero }]}>
        <div class="hero-content">
          <p class="label">{profile.trade} <span aria-hidden="true">/</span> {profile.location}</p>
          <h1>{profile.headline ?? profile.name}</h1>
          <p class="description">{profile.intro}</p>
          <a class="shop-button" href={contactHref ?? '#services'}>
            {contactHref ? contactLabel : 'Find your service'}
            <span aria-hidden="true">{contactHref ? '↗' : '↓'}</span>
          </a>
        </div>
        {hero && (
          <img src={hero} alt="Classic fastback parked in the Juniper workshop" width="1440" height="960" fetchpriority="high" />
        )}
      </section>
      <section class="shop-wrap services" id="services">
        <div class="section-intro">
          <p class="label">Services</p>
          <h2>{concerns ? 'What brings you in?' : 'Explore services'}</h2>
          {concerns && <p>Choose what you’re dealing with to see where to start.</p>}
        </div>
        {concerns ? (
          <div class="choices">
            {concerns.map(({ title, copy, service }) => (
              <details name="juniper-concerns">
                <summary>{title}</summary>
                <div class="answer">
                  <p class="label">{service}</p>
                  <p>{copy}</p>
                </div>
              </details>
            ))}
          </div>
        ) : (
          <ul class="choices service-choices">
            {profile.services.map(({ name, descriptions }) => (
              <li>
                {descriptions.length ? (
                  <details name="dossier-services">
                    <summary>{name}</summary>
                    <div class="answer">{descriptions.map(description => <p>{description}</p>)}</div>
                  </details>
                ) : <p class="service-name">{name}</p>}
              </li>
            ))}
          </ul>
        )}
      </section>
      {profile.story && (
        <section class="story" id="workshop">
          <div class:list={['shop-wrap story-grid', { 'has-image': craft }]}>
            {craft && <img src={craft} alt="Mechanic working under the hood of a classic car" width="1000" height="667" loading="lazy" />}
            <div class="section-intro">
              <p class="label">{sample ? 'In the workshop' : 'About'}</p>
              <h2>{sample ? 'A careful look comes first.' : profile.name}</h2>
              <p>{profile.story}</p>
            </div>
          </div>
        </section>
      )}
      <div class="shop-end">
        <div class="shop-wrap end-inner">
          <p>{profile.name}<small>{profile.location}</small></p>
          {contactHref ? <a href={contactHref}>{contactLabel} <span aria-hidden="true">↗</span></a> : <a href="#shop">Back to top <span aria-hidden="true">↑</span></a>}
        </div>
      </div>
    </div>
    <section class="wrap offer" id="offer" aria-label="SiteBefore offer"><slot /></section>
  </main>
  <footer>
    <div class="wrap">
      <Brand inverse />
      <p>{sample ? 'Illustrative business and imagery created for this sample.' : `Concept prepared for ${profile.name}. This preview is not their live website.`}</p>
    </div>
  </footer>
</Base>

<style>
  .preview-bar { background: var(--paper); border-bottom: 1px solid var(--line); }
  .bar-wrap { display: flex; align-items: center; justify-content: space-between; gap: 9px; min-height: 58px; }
  .bar-wrap > span, .bar-wrap > a:last-child { font-size: 0.78rem; font-weight: 750; }
  .bar-wrap > span { color: var(--muted); text-align: center; }
  .bar-wrap > a:last-child { text-align: right; }
  .shop {
    --shop-black: #191b19;
    --shop-paper: #f4f0e8;
    --shop-rust: #f7986d;
    --shop-display: 'Barlow Condensed', 'Bricolage Grotesque Variable', sans-serif;
    background: var(--shop-paper);
    color: var(--shop-black);
  }
  .dossier {
    --shop-black: #142522;
    --shop-paper: #f2f4ea;
    --shop-rust: #bce6bb;
    --shop-display: 'Bricolage Grotesque Variable', sans-serif;
  }
  .dossier .work-hero { background: linear-gradient(120deg, var(--shop-black) 30%, #2b4c40); }
  .dossier .hero-content h1 {
    font-size: clamp(2.65rem, 7vw, 6.75rem);
    line-height: 0.98;
    text-transform: none;
  }
  .dossier .section-intro h2 {
    font-size: clamp(2.1rem, 4.55vw, 4.25rem);
    line-height: 1.04;
    text-transform: none;
  }
  .dossier .shop-button:hover { background: #d5f1cd; }
  .dossier .story { background: #e0ebdf; }
  .dossier .choices summary:hover, .dossier .choices details[open] summary { color: #2b6346; }
  .shop-wrap { width: min(1280px, calc(100% - 2 * clamp(20px, 5vw, 72px))); margin-inline: auto; }
  .shop-header, .work-hero, .shop-end { background: var(--shop-black); color: var(--shop-paper); }
  .shop-header { border-bottom: 1px solid #fff2; }
  .shop-nav, .end-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .shop-nav { min-height: 76px; padding-block: 12px; }
  .wordmark {
    font: 700 clamp(1.35rem, 3vw, 2.15rem)/0.9 var(--shop-display);
    text-transform: uppercase;
    letter-spacing: 0.025em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .wordmark small { display: block; color: var(--shop-rust); font-size: 0.55em; letter-spacing: 0.19em; margin-top: 5px; }
  .shop-nav nav { display: flex; flex-wrap: wrap; gap: 5px clamp(15px, 4vw, 44px); justify-content: end; }
  .shop-nav nav a, .end-inner a { font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .shop-nav nav a { display: inline-flex; align-items: center; min-height: 44px; }
  .shop-nav nav a:hover, .end-inner a:hover { text-decoration: underline; }
  .work-hero { display: grid; }
  .work-hero.illustrated { grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); }
  .hero-content {
    display: grid;
    align-content: center;
    justify-items: start;
    padding: clamp(52px, 7vw, 100px) clamp(20px, 5vw, 72px);
  }
  .work-hero:not(.illustrated) .hero-content { width: 100%; max-width: 1424px; margin-inline: auto; }
  .label { font: 700 0.75rem/1.5 var(--body); text-transform: uppercase; letter-spacing: 0.12em; }
  .hero-content .label { color: var(--shop-rust); }
  .hero-content .label span { margin-inline: 3px; }
  .hero-content h1 {
    font: 700 clamp(3.1rem, 8.3vw, 7.5rem)/0.84 var(--shop-display);
    letter-spacing: -0.018em;
    text-transform: uppercase;
    white-space: pre-line;
    overflow-wrap: anywhere;
    margin-block: 22px;
    max-width: 17ch;
  }
  .description { max-width: 37ch; font-size: clamp(1rem, 1.4vw, 1.16rem); color: #dfdbd2; }
  .shop-button {
    display: inline-flex;
    align-items: center;
    gap: 23px;
    justify-content: space-between;
    min-height: 48px;
    margin-top: 26px;
    padding: 11px 17px;
    background: var(--shop-rust);
    color: var(--shop-black);
    text-decoration: none;
    font-weight: 800;
  }
  .shop-button:hover { background: #ffb08b; }
  .work-hero > img { height: 100%; object-fit: cover; object-position: center; }
  .services, .story-grid { padding-block: clamp(46px, 7vw, 100px); }
  .services { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 30px clamp(25px, 6vw, 92px); }
  .section-intro h2 {
    font: 700 clamp(2.65rem, 5.6vw, 5rem)/0.92 var(--shop-display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    margin-block: 12px 16px;
  }
  .section-intro > p:last-child { max-width: 46ch; }
  .choices { border-top: 1px solid #aea599; }
  .choices details, .service-name { border-bottom: 1px solid #aea599; }
  .choices summary, .service-name {
    font: 700 clamp(1.3rem, 2.7vw, 1.9rem)/1.1 var(--shop-display);
    padding-block: 19px;
    overflow-wrap: anywhere;
  }
  .choices summary { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-inline: 8px; cursor: pointer; }
  .choices summary:focus-visible { outline-offset: -3px; }
  .choices summary::-webkit-details-marker { display: none; }
  .choices summary::after { content: ''; inline-size: 10px; block-size: 10px; margin-right: 4px; border-right: 2px solid; border-bottom: 2px solid; transform: rotate(45deg); flex: none; }
  .choices details[open] summary::after { transform: rotate(225deg); }
  .choices summary:hover, .choices details[open] summary, .answer .label { color: #8e341d; }
  .answer { display: grid; gap: 6px; padding: 0 8px 22px; max-width: 58ch; }
  .service-choices { margin: 0; padding: 0; list-style: none; }
  .service-name { padding-inline: 8px; }
  .story { background: #e8dfd1; }
  .story-grid { display: grid; align-items: center; gap: clamp(24px, 5vw, 78px); }
  .story-grid.has-image { grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); }
  .story-grid img { aspect-ratio: 3/2; object-fit: cover; }
  .end-inner { padding-block: 22px; flex-wrap: wrap; }
  .end-inner p { font-weight: 800; overflow-wrap: anywhere; }
  .end-inner small { display: block; font-weight: 500; color: #dfdbd2; }
  .shop-header :focus-visible, .work-hero :focus-visible, .shop-end :focus-visible { outline-color: var(--shop-rust); }
  .offer { padding-block: clamp(36px, 6vw, 75px); }
  footer { background: var(--green); color: var(--cream); padding-block: 21px; }
  footer > .wrap { display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; }
  footer p { font-size: 0.86rem; }
  @media (max-width: 760px) {
    .work-hero.illustrated, .services, .story-grid.has-image { grid-template-columns: minmax(0, 1fr); }
    .work-hero > img { height: auto; aspect-ratio: 3/2; }
    .hero-content { padding-block: 36px; }
    .hero-content h1 { font-size: clamp(3.25rem, 13vw, 6rem); }
  }
  @media (max-width: 420px) {
    .bar-wrap > span, .bar-wrap > a:last-child { font-size: 0.68rem; }
  }
</style>
