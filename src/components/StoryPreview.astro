---
import Base from '../layouts/Base.astro';
import Brand from './Brand.astro';
const { profile, sample = false } = Astro.props;
---

<Base title={`${profile.name} · SiteBefore Preview`} privatePage>
  <aside class="preview-bar">
    <div class="wrap bar-wrap">
      <Brand /><span>{sample ? 'Fictional sample' : 'Private preview · Unaffiliated'}</span><a href="#offer"
        >{sample ? 'Launch package' : 'Review your offer'} <span aria-hidden="true">↓</span></a>
    </div>
  </aside>
  <main>
    <section class:list={['work-hero', { illustrated: profile.hero }]}>
      {profile.hero && <img src={profile.hero} alt="" width="1280" height="853" fetchpriority="high" />}
      <div class="wrap content">
        <p class="eyebrow">{profile.trade} · {profile.location}</p>
        <p class="shop">{profile.name}</p>
        <h1>{profile.headline ?? profile.name}</h1>
        <p class="description">{profile.intro}</p>
        <a class="button light" href="#services">Explore services <span aria-hidden="true">↓</span></a>
      </div>
    </section>
    <section class="wrap services" id="services">
      <p class="eyebrow">Services</p>
      <h2>{profile.hero ? 'Back on the road.' : 'How we can help.'}</h2>
      <ul>{profile.services.map((service) => <li>{service}</li>)}</ul>
    </section>
    {
      profile.story && (
        <section class="story">
          <div class:list={['wrap story-grid', { 'has-image': profile.craft }]}>
            {profile.craft && (
              <img
                src={profile.craft}
                alt="Illustration of a mechanic working on an engine"
                width="1000"
                height="667"
                loading="lazy"
              />
            )}
            <div>
              <>
                <p class="eyebrow">Our story</p>
                <h2>{profile.hero ? 'Care in the work.' : profile.name}</h2>
                <p>{profile.story}</p>
              </>
            </div>
          </div>
        </section>
      )
    }
    <section class="wrap offer" id="offer"><slot /></section>
  </main>
  <footer>
    <div class="wrap">
      <Brand inverse /><p>
        {
          sample
            ? 'Illustrative business and imagery created for this sample.'
            : `Concept prepared for ${profile.name}. This preview is not their live website.`
        }
      </p>
    </div>
  </footer>
</Base>
<style>
  .preview-bar {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .bar-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 62px;
  }
  .bar-wrap > span {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 750;
    color: var(--muted);
  }
  .bar-wrap > a:last-child {
    font-size: 0.83rem;
    font-weight: 750;
    text-align: right;
  }
  .work-hero {
    background: #243a2d;
    color: #fcf0d9;
    position: relative;
    overflow: hidden;
  }
  .work-hero > img {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    object-position: center 56%;
  }
  .work-hero.illustrated::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #14251bed 5%, #14251bc0 34%, #14251b07 90%);
  }
  .content {
    position: relative;
    z-index: 1;
    padding-block: clamp(74px, 9vw, 125px);
  }
  .work-hero .eyebrow {
    color: #f1b4a0;
  }
  .shop {
    font-weight: 800;
    margin-top: 10px;
  }
  .work-hero h1 {
    margin-block: 14px;
    white-space: pre-line;
    font: 400 clamp(4rem, 9vw, 8rem) / 0.85 var(--serif);
    letter-spacing: -0.04em;
    max-width: 750px;
    overflow-wrap: anywhere;
  }
  .description {
    margin-block: 22px;
    max-width: 390px;
    color: #fff5e5;
  }
  .services,
  .offer {
    padding-block: 55px;
  }
  .services h2,
  .story h2 {
    font: 400 clamp(2.7rem, 6vw, 5rem) / 0.95 var(--serif);
    margin-block: 10px 20px;
  }
  .services ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .services li {
    border: 1px solid var(--line);
    padding: 16px;
    background: var(--paper);
    font-weight: 800;
  }
  .story {
    background: #e8e4d7;
  }
  .story-grid {
    display: grid;
    gap: 25px;
    padding-block: 35px;
    align-items: center;
  }
  .story-grid.has-image {
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 5vw, 65px);
  }
  .story img {
    border-radius: 6px;
  }
  .story-grid p:last-child {
    max-width: 52ch;
  }
  .offer {
    scroll-margin-top: 20px;
  }
  footer {
    background: var(--green);
    color: var(--cream);
    padding-block: 21px;
  }
  footer > .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
  }
  footer p {
    font-size: 0.86rem;
  }
  @media (max-width: 650px) {
    .story-grid.has-image {
      grid-template-columns: 1fr;
    }
    .bar-wrap {
      min-height: 60px;
    }
    .bar-wrap > span {
      font-size: 0.62rem;
    }
    .bar-wrap > a:last-child {
      font-size: 0.68rem;
    }
    .work-hero.illustrated::after {
      background: linear-gradient(90deg, #14251be9, #14251b54);
    }
    .work-hero h1 {
      font-size: clamp(3rem, 13vw, 5rem);
    }
  }
</style>
