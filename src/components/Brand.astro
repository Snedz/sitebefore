---
const { href = '/', inverse = false } = Astro.props;
---

<a class:list={['brand', { inverse }]} href={href}>
  <span class="mark" aria-hidden="true"
    ><svg width="18" height="18" viewBox="0 0 24 24" fill="none"
      ><rect x="4.5" y="5.5" width="13" height="14" rx="2" stroke="currentColor" stroke-width="1.6"
      ></rect><path
        d="M7.5 15.5l3-3 2 2 5.5-5.5M15 9h4v4"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    ></span
  >
  SiteBefore<span class="period">.</span>
</a>
<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 790;
    letter-spacing: -0.05em;
    font-size: 1.35rem;
    color: var(--ink);
    line-height: 1;
  }
  .brand.inverse {
    color: var(--cream);
  }
  .mark {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    background: var(--coral);
    color: var(--ink);
    border-radius: 8px;
  }
  .period {
    color: #b64029;
    margin-left: -7px;
  }
  .inverse .period {
    color: var(--coral);
  }
</style>
