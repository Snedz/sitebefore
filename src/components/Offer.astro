---
// Offer.astro — the SiteBefore public one-page offer site (sitebefore.com).
// Copy source: files/offer-sheet-structure-and-trust-copy-2026-10-30.md (via src/data/offer.json).
// House rules baked in here:
//  - NO prices render. Prices are founder-unset; the page renders the honest
//    "pricing on the call / fixed quote" placeholder. [FOUNDER PRICE] slots
//    live in offer.json + the launch plan, never on the public page.
//  - No testimonials, no client logos, no results claims. The pilot is
//    described as in-progress, with no outcomes attached.
//  - The intake form posts to offer.intakeEndpoint, which is a PLACEHOLDER
//    until the founder wires a real endpoint (see launch plan §1). The page
//    says so in an HTML comment only — do not deploy with the placeholder.
const { offer } = Astro.props;
const o = offer;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SiteBefore — Websites that book, run like a front office</title>
    <meta name="description" content="SiteBefore builds appointment businesses a website that books, then runs the weekly work behind it: enquiries answered, reviews collected, pages published. Fixed quote before work starts." />
    <style>
      :root {
        --ink: #23272e;
        --navy: #17324a;
        --teal: #0e7a6d;
        --paper: #fbfaf7;
        --sand: #f1eadf;
        --line: #ddd3c2;
        --muted: #6b7280;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink); background: var(--paper); line-height: 1.55; }
      h1, h2, h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 600; color: var(--navy); }
      a { color: var(--teal); }
      header.topbar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 1.1rem; background: var(--paper); border-bottom: 1px solid var(--line); }
      .brand { font-family: Georgia, serif; font-size: 1.15rem; color: var(--navy); }
      .btn { display: inline-block; background: var(--teal); color: #fff; text-decoration: none; padding: 0.65rem 1.3rem; border-radius: 999px; font-weight: 600; white-space: nowrap; border: none; cursor: pointer; font-size: 1rem; }
      .btn.ghost { background: transparent; color: #fff; border: 2px solid #fff; }
      .hero { background: linear-gradient(135deg, var(--navy) 0%, #1f4a5e 60%, var(--teal) 130%); color: #fff; text-align: center; padding: 3.4rem 1.2rem 2.8rem; }
      .hero h1 { color: #fff; font-size: 2.15rem; line-height: 1.2; margin-bottom: 0.7rem; }
      .hero .sub { font-size: 1.08rem; opacity: 0.93; max-width: 720px; margin: 0 auto; }
      .hero .ctas { margin-top: 1.7rem; display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }
      main { max-width: 900px; margin: 0 auto; padding: 0 1.1rem; }
      section { padding: 2.3rem 0 0.4rem; }
      section h2 { font-size: 1.55rem; margin-bottom: 1rem; border-bottom: 2px solid var(--line); padding-bottom: 0.4rem; }
      .steps { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
      @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, 1fr); } }
      .step { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.1rem; }
      .step .n { font-weight: 700; color: var(--teal); margin-bottom: 0.3rem; }
      .role { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1.15rem 1.25rem; margin-bottom: 1rem; }
      .role h3 { font-size: 1.2rem; }
      .role .outcome { font-style: italic; color: var(--teal); margin: 0.25rem 0 0.6rem; }
      .role ul { margin-left: 1.2rem; }
      .role li { margin: 0.25rem 0; }
      .entry { background: var(--sand); border: 1px solid var(--line); border-radius: 12px; padding: 1.15rem 1.25rem; }
      .pricing-note { background: var(--sand); border-left: 4px solid var(--teal); border-radius: 8px; padding: 1rem 1.15rem; }
      .trust { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
      @media (min-width: 720px) { .trust { grid-template-columns: repeat(2, 1fr); } }
      .trust .t { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.1rem; }
      .trust .t strong { color: var(--navy); display: block; margin-bottom: 0.25rem; }
      .pilot { color: var(--muted); font-size: 0.95rem; }
      form.intake { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem; display: grid; gap: 0.8rem; }
      form.intake label { font-weight: 600; font-size: 0.95rem; display: grid; gap: 0.3rem; }
      form.intake input, form.intake select, form.intake textarea { font: inherit; padding: 0.55rem 0.7rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
      footer { margin-top: 2.8rem; background: var(--navy); color: #dbe7ee; text-align: center; padding: 1.7rem 1.1rem; font-size: 0.92rem; }
      footer .fname { font-family: Georgia, serif; font-size: 1.05rem; color: #fff; }
    </style>
  </head>
  <body>
    <header class="topbar">
      <span class="brand">SiteBefore</span>
      <a class="btn" href="#intake">Book a short call</a>
    </header>

    <div class="hero">
      <h1>{o.headline}</h1>
      <p class="sub">{o.subhead}</p>
      <div class="ctas">
        <a class="btn" href="#intake">Book a short call</a>
        <a class="btn ghost" href="#how">How it works</a>
      </div>
    </div>

    <main>
      <section id="how">
        <h2>How it works</h2>
        <div class="steps">
          {o.howItWorks.map((s) => (
            <div class="step">
              <div class="n">{s.step}</div>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="entry">
        <h2>Start with the website</h2>
        <div class="entry">
          <h3>{o.entryBuild.name}</h3>
          <p style="margin-top:0.4rem;">{o.entryBuild.text}</p>
        </div>
      </section>

      <section id="roles">
        <h2>Then the office runs it</h2>
        {o.roles.map((r) => (
          <div class="role">
            <h3>{r.name}</h3>
            <p class="outcome">“{r.outcome}”</p>
            <ul>
              {r.workflows.map((w) => <li>{w}</li>)}
            </ul>
          </div>
        ))}
        <div class="pricing-note">
          <strong>Pricing.</strong> {o.pricingPlaceholder}
        </div>
      </section>

      <section id="trust">
        <h2>How we work</h2>
        <div class="trust">
          {o.trust.map((t) => (
            <div class="t">
              <strong>{t.line}</strong>
              <span>{t.text}</span>
            </div>
          ))}
        </div>
        <p class="pilot" style="margin-top:1.1rem;">{o.pilotNote}</p>
      </section>

      <section id="intake">
        <h2>Book a short call</h2>
        <p style="margin-bottom:1rem;">Tell us where to look. We audit your current site first — the call starts with findings about your business, not a pitch deck.</p>
        {/* Intake wired Nov 15, 2026 per monday-launch-plan-2026-11-01.md §1 option (i): the button opens the "SiteBefore — Book a short call" Google Form (same fields); responses land in the founder's Google account. */}
        <p><a class="btn" href={o.intakeEndpoint} target="_blank" rel="noopener">Book a short call — we'll reply with your audit findings</a></p>
      </section>
    </main>

    <footer>
      <p class="fname">SiteBefore</p>
      <p>Websites that book, run like a front office. Built in Toronto.</p>
    </footer>
  </body>
</html>
