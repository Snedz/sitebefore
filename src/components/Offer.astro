---
// Offer.astro — the SiteBefore public page (sitebefore.com), no-call flow.
// Spec: MissionWinning/67 VENTURES/site-to-sale/SPEC_LOCK.md (founder yes 2026-11-16 5:12 PM ET).
// House rules baked in here:
//  - No calls anywhere: no "book a call", no "pricing set on a call".
//  - Prices are fixed and published (CAD, plus applicable tax).
//  - Checkout is NOT wired yet: Publish/Care buttons record intent via the intake.
//  - The intake posts URL + email to the existing Google Form (responses land in
//    the founder's Google account). Visitors never see the form itself.
//  - No testimonials, no client logos, no results claims.
import SiteFooter from './SiteFooter.astro';
const { offer } = Astro.props;
const o = offer;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SiteBefore — See your new website before you pay</title>
    <meta name="description" content="Enter your website. Get an automatic audit and a free preview of your new site. Publish it online for $599 CAD, one-time. No calls." />
    <style is:global>
      :root { --ink:#23272e; --navy:#17324a; --teal:#0e7a6d; --paper:#fbfaf7; --sand:#f1eadf; --line:#ddd3c2; --muted:#6b7280; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink); background: var(--paper); line-height: 1.55; }
      h1, h2, h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 600; color: var(--navy); }
      a { color: var(--teal); }
      header.topbar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 1.1rem; background: var(--paper); border-bottom: 1px solid var(--line); }
      .brand { font-family: Georgia, serif; font-size: 1.15rem; color: var(--navy); text-decoration: none; }
      .btn { display: inline-block; background: var(--teal); color: #fff; text-decoration: none; padding: 0.65rem 1.3rem; border-radius: 999px; font-weight: 600; white-space: nowrap; border: none; cursor: pointer; font-size: 1rem; }
      .btn.ghost { background: transparent; color: var(--teal); border: 2px solid var(--teal); }
      .btn[disabled] { opacity: 0.6; cursor: wait; }
      .hero { background: linear-gradient(135deg, var(--navy) 0%, #1f4a5e 60%, var(--teal) 130%); color: #fff; padding: 3.2rem 1.2rem 2.8rem; }
      .hero-inner { max-width: 760px; margin: 0 auto; text-align: center; }
      .hero h1 { color: #fff; font-size: 2.2rem; line-height: 1.2; margin-bottom: 0.7rem; }
      .hero .sub { font-size: 1.08rem; opacity: 0.93; }
      main { max-width: 920px; margin: 0 auto; padding: 0 1.1rem; }
      section { padding: 2.3rem 0 0.4rem; }
      section h2 { font-size: 1.55rem; margin-bottom: 1rem; border-bottom: 2px solid var(--line); padding-bottom: 0.4rem; }
      .card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.1rem; }
      .steps { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
      @media (min-width: 720px) { .steps { grid-template-columns: repeat(3, 1fr); } }
      .step .n { font-weight: 700; color: var(--teal); }
      .step h3 { font-size: 1.1rem; margin: 0.1rem 0 0.3rem; }
      .plans { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
      @media (min-width: 720px) { .plans { grid-template-columns: repeat(3, 1fr); } }
      .plan { display: flex; flex-direction: column; gap: 0.5rem; }
      .plan .price { font-family: Georgia, serif; font-size: 2rem; color: var(--navy); }
      .plan .unit { font-size: 0.9rem; color: var(--muted); }
      .plan p { flex: 1; }
      .plan.featured { border: 2px solid var(--teal); }
      .note { color: var(--muted); font-size: 0.93rem; margin-top: 0.8rem; }
      .trust { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
      @media (min-width: 720px) { .trust { grid-template-columns: repeat(2, 1fr); } }
      .trust strong { color: var(--navy); display: block; margin-bottom: 0.25rem; }
      form.intake { background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 14px; padding: 1.25rem; display: grid; gap: 0.8rem; text-align: left; margin-top: 1.6rem; }
      form.intake label { font-weight: 600; font-size: 0.95rem; display: grid; gap: 0.3rem; }
      form.intake label.check { display: flex; gap: 0.5rem; align-items: flex-start; font-weight: 400; font-size: 0.9rem; }
      form.intake input[type=text], form.intake input[type=url], form.intake input[type=email] { font: inherit; padding: 0.6rem 0.75rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
      .intent { background: var(--sand); border-radius: 8px; padding: 0.55rem 0.75rem; font-size: 0.93rem; }
      .done { background: #fff; color: var(--ink); border-radius: 14px; padding: 1.4rem; margin-top: 1.6rem; text-align: left; }
      .done h3 { margin-bottom: 0.4rem; }
      .err { color: #9b1c1c; font-size: 0.93rem; }
      footer { margin-top: 2.8rem; background: var(--navy); color: #dbe7ee; text-align: center; padding: 1.7rem 1.1rem; font-size: 0.92rem; }
      footer .fname { font-family: Georgia, serif; font-size: 1.05rem; color: #fff; }
      footer .casl { margin-top: 0.7rem; font-size: 0.85rem; opacity: 0.9; }
      footer a { color: #bfe6df; }
    </style>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">SiteBefore</a>
      <a class="btn" href="#start">See my new site</a>
    </header>

    <div class="hero" id="start">
      <div class="hero-inner">
        <h1>{o.headline}</h1>
        <p class="sub">{o.subhead}</p>

        <form class="intake" id="intake" novalidate>
          <label>Your business website
            <input type="url" name="website" placeholder="https://yourbusiness.ca" inputmode="url" autocomplete="url" />
          </label>
          <label>Business name
            <input type="text" name="business" required autocomplete="organization" />
          </label>
          <label>Email (where we send your audit and preview)
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <p class="intent" id="intent-line" hidden></p>
          <label class="check">
            <input type="checkbox" name="consent" required />
            <span>Email me my audit, my preview, and messages about this order. I can unsubscribe anytime.</span>
          </label>
          <p class="err" id="intake-err" hidden></p>
          <button class="btn" type="submit" id="intake-btn">Get my free preview</button>
          <p class="note" style="margin-top:0">No card, no call. No website yet? Leave that box blank and we'll build from your business name.</p>
        </form>

        <div class="done" id="intake-done" hidden>
          <h3>Got it. Your audit is in the queue.</h3>
          <p>We'll email your audit and a link to your free preview to <strong id="done-email"></strong>. Everything after this happens by email. Nobody will call you.</p>
        </div>
      </div>
    </div>

    <main>
      <section id="how">
        <h2>How it works</h2>
        <div class="steps">
          {o.steps.map((s) => (
            <div class="card step">
              <div class="n">{s.n}</div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="pricing">
        <h2>Prices</h2>
        <div class="plans">
          {o.plans.map((p) => (
            <div class={`card plan${p.id === 'publish' ? ' featured' : ''}`}>
              <h3>{p.name}</h3>
              <div><span class="price">{p.price}</span> <span class="unit">{p.unit}</span></div>
              <p>{p.text}</p>
              <a class="btn" href="#start" data-intent={p.id}>{p.cta}</a>
            </div>
          ))}
        </div>
        <p class="note">{o.taxNote} {o.changesRule}</p>
        <p class="note">{o.checkoutNote}</p>
      </section>

      <section id="trust">
        <h2>How we work</h2>
        <div class="trust">
          {o.trust.map((t) => (
            <div class="card">
              <strong>{t.line}</strong>
              <span>{t.text}</span>
            </div>
          ))}
        </div>
      </section>
    </main>

    <SiteFooter operator={o.operator} />

    <script is:inline define:vars={{ intake: o.intake, plans: o.plans }}>
      const form = document.getElementById('intake');
      const btn = document.getElementById('intake-btn');
      const err = document.getElementById('intake-err');
      const intentLine = document.getElementById('intent-line');
      let intent = 'preview';

      document.querySelectorAll('[data-intent]').forEach((a) => {
        a.addEventListener('click', () => {
          intent = a.dataset.intent;
          if (intent === 'preview') { intentLine.hidden = true; return; }
          const plan = plans.find((p) => p.id === intent);
          intentLine.textContent = `You picked: ${plan.name} (${plan.price} ${plan.unit}). Online checkout opens soon, so we start with your free preview and email you the payment link with it.`;
          intentLine.hidden = false;
        });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        err.hidden = true;
        const d = new FormData(form);
        const email = (d.get('email') || '').toString().trim();
        const business = (d.get('business') || '').toString().trim();
        let website = (d.get('website') || '').toString().trim();
        if (website && !/^https?:\/\//i.test(website)) website = 'https://' + website;
        const problems = [];
        if (!business) problems.push('your business name');
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) problems.push('a valid email');
        if (!d.get('consent')) problems.push('the email consent box');
        if (problems.length) { err.textContent = 'Please add ' + problems.join(', ') + '.'; err.hidden = false; return; }

        const f = intake.fields;
        const body = new URLSearchParams();
        body.set(f.business, business);
        body.set(f.name, '-');
        body.set(f.email, email);
        if (website) body.set(f.website, website);
        body.set(f.interest, website ? 'Redo my current website' : 'A new website');
        body.set(f.notes, `source=sitebefore.com no-call intake v2; intent=${intent}; casl_express_consent=yes at ${new Date().toISOString()}`);

        btn.disabled = true; btn.textContent = 'Sending…';
        try {
          await fetch(intake.endpoint, { method: 'POST', mode: 'no-cors', body });
          document.getElementById('done-email').textContent = email;
          form.hidden = true;
          document.getElementById('intake-done').hidden = false;
        } catch (_) {
          err.textContent = 'That did not go through. Check your connection and try again.';
          err.hidden = false;
          btn.disabled = false; btn.textContent = 'Get my free preview';
        }
      });
    </script>
  </body>
</html>
